# ---------- HTTP ----------
PORT=4000
# comma separated list of allowed web origins (mobile apps are not affected by CORS)
CORS_ORIGINS=http://localhost:8081
JWT_SECRET=change-me-to-a-long-random-string

# ---------- SQL Server 2008 ----------
DB_SERVER=localhost
DB_PORT=1433
# named instance, e.g. SQLEXPRESS (leave empty when using a port)
DB_INSTANCE=
DB_NAME=CarWash
DB_USER=carwash_app
DB_PASSWORD=
# SQL Server 2008 = 7_3_A, 2008 R2 = 7_3_B
DB_TDS_VERSION=7_3_A
# SQL Server 2008 only speaks TLS 1.0 unless patched - keep false on a trusted LAN
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true

# ---------- first admin (created on first start if no admin exists) ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULLNAME=מנהל המערכת

# ---------- OTP / SMS ----------
# console = print codes to the server log (development)
SMS_PROVIDER=console
# when true the OTP code is also returned in the API response (NEVER in production)
OTP_DEV_MODE=true

# ---------- payments ----------
# The clearing company (Cardcom / Tranzila / demo) and its credentials are set
# from the admin panel (ניהול -> סליקת אשראי) and stored encrypted in the DB.
# Public https address of this server - the clearing company calls it back:
PUBLIC_URL=https://api.example.co.il
# key used to encrypt the payment credentials (long random string; do not lose it)
SETTINGS_ENCRYPTION_KEY=change-me-too
